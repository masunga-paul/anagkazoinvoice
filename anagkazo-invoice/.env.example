# Neon PostgreSQL Serverless Database Connection URL
DATABASE_URL="postgresql://<username>:<password>@<endpoint-pooler>.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional HMAC Auth Secret (random 32+ characters)
AUTH_SECRET="your-secure-custom-secret-key-here"

# Neon Public Auth (Optional)
PUBLIC_NEON_AUTH_URL="https://<auth-endpoint>.neonauth.us-east-2.aws.neon.tech/neondb/auth"
PUBLIC_NEON_JWKS_URL="https://<auth-endpoint>.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
