{
	"name": "anagkazo-invoice",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"deploy": "vite build && wrangler pages deploy .svelte-kit/cloudflare"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.35.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.13.1",
		"clsx": "^2.1.1",
		"lucide-svelte": "^1.0.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.11",
		"wrangler": "^4.127.1",
		"zod": "^3.25.76"
	},
	"dependencies": {
		"@fontsource-variable/quicksand": "^5.3.0",
		"@neondatabase/serverless": "^1.1.0",
		"html-to-image": "^1.11.13",
		"html2canvas": "^1.4.1",
		"html2pdf.js": "^0.14.0",
		"jspdf": "^4.2.1",
		"jspdf-autotable": "^5.0.8",
		"sveltekit-superforms": "^2.30.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"core-js"
		]
	}
}
